# Copy to .env and fill in before `docker compose up`. Docker Compose loads .env
# automatically. Do NOT commit the real .env (see .gitignore).

# Public address Caddy serves on. Use a HOSTNAME, not a bare ":443" — Caddy
# needs a name to issue a cert for, or the TLS handshake fails with an
# internal-error alert.
#   - Local testing:   SITE_ADDRESS=localhost   (Caddy's internal CA issues a
#     localhost cert; the browser shows a one-time warning — accept it)
#   - Public demo:      SITE_ADDRESS=demo.example.com   (a real domain gets an
#     automatic, fully-trusted Let's Encrypt cert — best, and cleanest webcam
#     prompt). A free subdomain from DuckDNS works great.
SITE_ADDRESS=localhost

# HTTP Basic auth for the whole demo.
BASIC_AUTH_USER=demo
# bcrypt hash of your password — generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password-here'
#
# IMPORTANT: docker compose treats "$" in .env as variable references, so you
# MUST double every "$" in the hash ($ -> $$). Example: a generated hash of
#   $2a$14$dsxa...   is written here as   $$2a$$14$$dsxa...
# (Compose collapses $$ back to a single $ before Caddy sees it.)
BASIC_AUTH_HASH=
